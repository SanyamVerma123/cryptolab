{
  "framework": "vite",
  "installCommand": "npm update && npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/luxalgo/:path*",
      "destination": "/api/luxalgo/:path*"
    },
    {
      "source": "/((?!api/|luxalgo/).*)",
      "destination": "/index.html"
    }
  ]
}
