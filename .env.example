# Point the deployed app at your AI relay (optional).
# When empty, the app talks to /ai on its own origin (the Vite dev server
# serves the relay in dev). Set this only for a static deploy that has a
# separate relay host.
# VITE_AI_RELAY_URL=https://your-relay.example.com

# Optional: allow a specific custom hostname when exposing the Vite dev server
# through a tunnel. Use comma-separated hostnames; avoid wildcard allowlists.
# TRADEPRO_ALLOWED_HOSTS=your-tunnel.example.com
